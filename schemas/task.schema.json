{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/schemas/task.schema.json",
  "title": "Agent Workbench Task",
  "type": "object",
  "required": [
    "id",
    "status",
    "primaryRole",
    "primaryProject",
    "projects",
    "readScopes",
    "writeScopes",
    "secretPolicy"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "closed", "cancelled"] },
    "objective": { "type": "string" },
    "audience": { "type": "string" },
    "primaryRole": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "supportingRoles": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
    },
    "workflows": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
    },
    "primaryProject": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
    },
    "browserTargets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "readScopes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^project:[a-z0-9][a-z0-9._-]*(/.*)?$" }
    },
    "writeScopes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^project:[a-z0-9][a-z0-9._-]*(/.*)?$" }
    },
    "deliverables": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
    },
    "qualityGates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "status": { "enum": ["pending", "passed"] },
          "note": { "type": ["string", "null"] },
          "passedAt": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "secretPolicy": { "const": "runtime-only" }
  },
  "additionalProperties": true
}
